@using BucHunt.Models

@{
    ViewData["Title"] = "Hunt Tasks";
}

<div class="text-left" style="margin-top: -60px;">
    <header>
        <img src="~/assets/Hunt-Tasks-logo.png"
             alt="ScavengeRUS Logo"
             class="logos"
             style="margin-left: -100px;" />
    </header>

    <section>
        <h2>Available Tasks</h2>

        @if (ViewBag.ErrorMessage != null)
        {
            <div class="alert alert-danger" role="alert">
                @ViewBag.ErrorMessage
            </div>
        }
        else
        {
            <ul id="taskList">
                @foreach (ParsedTasks task in Model)
                {
                    <li class="@(task.Completed ? "task-completed" : "")">
                        Task @task.ID: @task.Label

                        @if (!task.Completed)
                        {
                            <form asp-controller="Player"
                                  asp-action="CompleteTask"
                                  method="post"
                                  style="display: inline;">
                                <input type="hidden" name="id" value="@task.ID" />
                                <button type="submit" class="btn btn-primary">
                                    Complete Task
                                </button>
                            </form>
                        }
                        else
                        {
                            <span>Completed</span>
                        }
                    </li>
                }
            </ul>
        }
    </section>
</div>

<script src="~/js/taskSorting.js"></script>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        sortTasks();
    });
</script>
