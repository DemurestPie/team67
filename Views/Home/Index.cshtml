@{
    ViewData["Title"] = "ScavengeRUS";
}

<div class="text-center" style="margin-top: -80px;">

    <header>
            <img src="~/assets/ScavengeRUS-logo.png" alt="ScavengeRUS Logo" class="homeLogo" />
            <p class="lead">Explore. Complete tasks. Finish the hunt.</p>
    </header>
    
    <!-- Main Landing Page Content -->
    <div class="row justify-content-center">
        <div class="col-12 col-md-8">

            <div class="card shadow-sm">
                <div class="card-body p-4">

                    <!-- Introduces the platform so participants understand the purpose of ScavengeRUS before entering a hunt. -->
                    <section class="text-center mb-5">
                        <h2>Welcome to ScavengeRUS</h2>

                        <div class="mt-3">
                            <p>
                                ScavengeRUS is an interactive scavenger hunt platform that allows
                                participants to explore different locations, complete tasks, and
                                track their progress throughout a hunt.
                            </p>

                            <p>
                                    Participants can visit participating locations and complete
                                    challenges as they work toward finishing the scavenger hunt.
                            </p>
                        </div>
                    </section>
                    <hr />

                    <!-- Hunt Access -->
                    <section class="text-center mt-5">
                        <h2>Ready to Start?</h2>
                            
                        <div class="mt-3">
                            <a href="#" class="btn btn-primary">Register</a>
                            <a href="#" class="btn btn-secondary">Access Hunt</a>
                        </div>
                    </section>

                </div>
            </div>

        </div>
    </div>

</div>